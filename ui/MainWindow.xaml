<?xml version='1.0' encoding='utf-8'?>
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="PowerDockUI.MainWindow" Title="PowerDock">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>
    <Grid x:Name="Root" UseLayoutRounding="True" Background="Transparent" RowSpacing="0">
        <Grid.Resources>
            <Style x:Key="HeaderIconButtonStyle" TargetType="Button" BasedOn="{StaticResource SubtleButtonStyle}">
                <Setter Property="Width" Value="32" />
                <Setter Property="Height" Value="32" />
                <Setter Property="MinWidth" Value="32" />
                <Setter Property="MinHeight" Value="32" />
                <Setter Property="Padding" Value="4" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>
            <Style x:Key="BatteryLowProgressStyle" TargetType="ProgressBar">
                <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCriticalBrush}" />
            </Style>
            <Style x:Key="BatteryChargingProgressStyle" TargetType="ProgressBar">
                <Setter Property="Foreground" Value="{ThemeResource SystemFillColorSuccessBrush}" />
            </Style>
            <Style x:Key="BatteryUnknownProgressStyle" TargetType="ProgressBar">
                <Setter Property="Foreground" Value="{ThemeResource ControlStrongFillColorDefaultBrush}" />
            </Style>
            <DataTemplate x:Key="DeviceCardTemplate">
                <Border Padding="16" CornerRadius="{ThemeResource OverlayCornerRadius}" BorderThickness="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                    <StackPanel Spacing="8">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon x:Name="CardGlyph" FontSize="20" VerticalAlignment="Center" />
                            <TextBlock x:Name="CardName" Grid.Column="1" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                            <Button x:Name="CardMore" Grid.Column="2" Style="{StaticResource SubtleButtonStyle}" Padding="8" MinWidth="32" MinHeight="32" ToolTipService.ToolTip="设备操作">
                                <FontIcon Glyph="" FontSize="16" />
                            </Button>
                        </Grid>
                        <Grid x:Name="CardChargeViewport" Height="36" HorizontalAlignment="Left">
                            <Grid.Clip><RectangleGeometry Rect="0,0,260,36" /></Grid.Clip>
                            <StackPanel x:Name="CardPercentRow" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <TextBlock x:Name="CardPercent" FontSize="28" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <Path x:Name="CardChargingGlyph" Data="M5.87282 1C5.43053 1 5.04078 1.29055 4.91447 1.71442L3.03074 8.03581C2.88743 8.51673 3.24769 9 3.74951 9H5.33338L4.05299 13.3888C3.66907 14.7047 5.37726 15.5898 6.23096 14.5173L12.8379 6.21709C13.229 5.72572 12.8791 5 12.2511 5H10.2216L11.2149 2.35112C11.4601 1.69737 10.9768 1 10.2786 1H5.87282Z" Width="13.5" Height="18" Stretch="Uniform" Fill="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Top" Visibility="Collapsed" AutomationProperties.AccessibilityView="Raw" />
                            </StackPanel>
                            <StackPanel x:Name="CardChargingRow" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Opacity="0" AutomationProperties.AccessibilityView="Raw">
                                <TextBlock x:Name="CardChargingHint" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" AutomationProperties.AccessibilityView="Raw" />
                                <Path x:Name="CardChargingHintGlyph" AutomationProperties.AccessibilityView="Raw" Data="M5.87282 1C5.43053 1 5.04078 1.29055 4.91447 1.71442L3.03074 8.03581C2.88743 8.51673 3.24769 9 3.74951 9H5.33338L4.05299 13.3888C3.66907 14.7047 5.37726 15.5898 6.23096 14.5173L12.8379 6.21709C13.229 5.72572 12.8791 5 12.2511 5H10.2216L11.2149 2.35112C11.4601 1.69737 10.9768 1 10.2786 1H5.87282Z" Width="9" Height="12" Stretch="Uniform" Fill="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Top" Visibility="Collapsed" />
                            </StackPanel>
                        </Grid>
                        <ProgressBar x:Name="CardProgress" Minimum="0" Maximum="100" Height="4" />
                        <Border x:Name="CardUnknownTrack" Height="4" CornerRadius="2" Background="{ThemeResource ControlStrokeColorDefaultBrush}" Visibility="Collapsed" AutomationProperties.AccessibilityView="Raw" />
                        <TextBlock x:Name="CardState" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="Collapsed" />
                    </StackPanel>
                </Border>
            </DataTemplate>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Margin="24,0,24,24" Grid.Row="1">
            <ScrollViewer x:Name="BatteryPage" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="16" Margin="0,0,12,0">
                    <Grid ColumnSpacing="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="4">
                            <TextBlock Tag="loc:Overview" Text="Devices" Style="{ThemeResource SubtitleTextBlockStyle}" />
                            <TextBlock Tag="loc:Discovering" x:Name="FleetSummary" Text="Discovering devices…" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                        <Button Tag="loc:Refresh" x:Name="RefreshButton" Grid.Column="1" Style="{StaticResource HeaderIconButtonStyle}" VerticalAlignment="Top" Click="RefreshClick" AutomationProperties.Name="刷新所有设备" ToolTipService.ToolTip="刷新所有设备">
                            <FontIcon Glyph="&#xE72C;" FontSize="16" Width="20" Height="20" IsTextScaleFactorEnabled="False" />
                        </Button>
                        <Button Tag="loc:Sort" x:Name="SortButton" Grid.Column="2" Style="{StaticResource HeaderIconButtonStyle}" VerticalAlignment="Top" AutomationProperties.Name="列表排序" ToolTipService.ToolTip="列表排序">
                            <FontIcon Glyph="&#xE8CB;" FontSize="16" Width="20" Height="20" IsTextScaleFactorEnabled="False" />
                            <Button.Flyout>
                                <MenuFlyout Placement="BottomEdgeAlignedRight">
                                    <RadioMenuFlyoutItem x:Name="SortBattery" Text="按电量" GroupName="DeviceSortKey" Tag="600" Click="SortClick" />
                                    <RadioMenuFlyoutItem x:Name="SortType" Text="按设备类型" GroupName="DeviceSortKey" Tag="601" Click="SortClick" />
                                    <RadioMenuFlyoutItem x:Name="SortCharging" Text="按充电状态" GroupName="DeviceSortKey" Tag="602" Click="SortClick" />
                                    <MenuFlyoutSeparator />
                                    <RadioMenuFlyoutItem x:Name="SortAscending" Text="升序" GroupName="DeviceSortOrder" Tag="610" Click="SortClick" />
                                    <RadioMenuFlyoutItem x:Name="SortDescending" Text="降序" GroupName="DeviceSortOrder" Tag="611" Click="SortClick" />
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>
                        <Button Tag="loc:Settings" x:Name="SettingsButton" Grid.Column="3" Style="{StaticResource HeaderIconButtonStyle}" VerticalAlignment="Top" Click="SettingsClick">
                            <FontIcon Glyph="&#xE713;" FontSize="16" Width="20" Height="20" IsTextScaleFactorEnabled="False" />
                        </Button>
                    </Grid>
                    <StackPanel x:Name="EmptyState" Spacing="4" Visibility="Collapsed">
                        <TextBlock Tag="loc:NoDevices" Text="No devices found" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                        <TextBlock Tag="loc:NoDevicesHint" Text="Connect a device, then select Refresh." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <Grid x:Name="DeviceRows" ColumnSpacing="12" RowSpacing="12" />
                    <TextBlock x:Name="DetailText" Visibility="Collapsed" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Style="{ThemeResource CaptionTextBlockStyle}" AutomationProperties.LiveSetting="Polite" />
                </StackPanel>
            </ScrollViewer>
            <NavigationView x:Name="SettingsPage" Visibility="Collapsed" PaneDisplayMode="Top" IsSettingsVisible="False" IsBackButtonVisible="Collapsed" SelectionChanged="SettingsNavigationChanged" AlwaysShowHeader="False" IsTitleBarAutoPaddingEnabled="False" BorderThickness="0" Background="Transparent">
                <NavigationView.Resources>
                    <x:Double x:Key="SettingsControlWidth">320</x:Double>
                    <Style x:Key="SettingsChoiceStyle" TargetType="ComboBox" BasedOn="{StaticResource DefaultComboBoxStyle}">
                        <Setter Property="Width" Value="{StaticResource SettingsControlWidth}" />
                        <Setter Property="HorizontalAlignment" Value="Left" />
                    </Style>
                    <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent" />
                    <Thickness x:Key="NavigationViewContentGridBorderThickness">0</Thickness>
                    <Thickness x:Key="TopNavigationViewContentGridBorderThickness">0</Thickness>
                    <Thickness x:Key="TopNavigationViewTopNavGridMargin">0</Thickness>
                    <Thickness x:Key="TopNavigationViewContentMargin">0</Thickness>
                    <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="NavigationViewTopPaneBackground" Color="Transparent" />
                </NavigationView.Resources>
                <NavigationView.MenuItems>
                    <NavigationViewItem x:Name="GeneralNav" Content="General" Tag="loc:General" />
                    <NavigationViewItem x:Name="NotificationsNav" Content="Notifications" Tag="loc:Notifications" />
                    <NavigationViewItem x:Name="AboutNav" Content="About" Tag="loc:About" />
                </NavigationView.MenuItems>
                <ScrollViewer x:Name="SettingsScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,16,8,0">
                    <Grid x:Name="SettingsContent">
                        <StackPanel x:Name="GeneralPanel" Spacing="20">
                            <ComboBox x:Name="LanguageChoice" Tag="loc:Language" Header="Display language" SelectedIndex="0" Style="{StaticResource SettingsChoiceStyle}" MaxWidth="{Binding ActualWidth, ElementName=SettingsContent}" SelectionChanged="GeneralChanged">
                                <ComboBoxItem Tag="loc:System" Content="Use system setting" />
                                <ComboBoxItem Content="简体中文" />
                                <ComboBoxItem Content="English" />
                            </ComboBox>
                            <ComboBox x:Name="ThemeChoice" Tag="loc:Theme" Header="App theme" SelectedIndex="0" Style="{StaticResource SettingsChoiceStyle}" MaxWidth="{Binding ActualWidth, ElementName=SettingsContent}" SelectionChanged="GeneralChanged">
                                <ComboBoxItem Tag="loc:System" Content="Use system setting" />
                                <ComboBoxItem Tag="loc:Light" Content="Light" />
                                <ComboBoxItem Tag="loc:Dark" Content="Dark" />
                            </ComboBox>
                            <ComboBox x:Name="IntervalChoice" Tag="loc:PollInterval" Header="Refresh interval" Style="{StaticResource SettingsChoiceStyle}" MaxWidth="{Binding ActualWidth, ElementName=SettingsContent}" SelectionChanged="IntervalChanged">
                                <ComboBoxItem Tag="loc:Seconds30" Content="30 seconds" />
                                <ComboBoxItem Tag="loc:Seconds60" Content="60 seconds" />
                                <ComboBoxItem Tag="loc:Seconds120" Content="120 seconds" />
                            </ComboBox>
                            <ToggleSwitch x:Name="StartupSwitch" Tag="loc:Startup" Header="Launch at sign-in" Toggled="StartupChanged" />
                            <StackPanel Spacing="6">
                                <TextBlock Tag="loc:Accessibility" Text="Accessibility" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                <ToggleSwitch x:Name="MotionSwitch" Tag="loc:ReduceMotion" Header="Reduce motion" Toggled="PreferenceToggled" />
                                <TextBlock x:Name="AccessibilityStatus" Visibility="Collapsed" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel x:Name="NotificationsPanel" Visibility="Collapsed" Spacing="16">
                            <ComboBox x:Name="ThresholdChoice" Tag="loc:DefaultReminder" Header="Default low-battery notification" Style="{StaticResource SettingsChoiceStyle}" MaxWidth="{Binding ActualWidth, ElementName=SettingsContent}" SelectionChanged="ThresholdChanged">
                                <ComboBoxItem Tag="loc:Off" Content="Off" />
                                <ComboBoxItem Content="10%" />
                                <ComboBoxItem Content="20%" />
                                <ComboBoxItem Content="30%" />
                            </ComboBox>
                            <ComboBox x:Name="NotificationStyleChoice" Tag="loc:NotificationStyle" Header="Notification style" SelectedIndex="0" Style="{StaticResource SettingsChoiceStyle}" MaxWidth="{Binding ActualWidth, ElementName=SettingsContent}" SelectionChanged="GeneralChanged">
                                <ComboBoxItem Tag="loc:NotificationWindows" Content="Windows notifications" />
                                <ComboBoxItem Tag="loc:NotificationOverlay" Content="NVIDIA-style popup" />
                                <ComboBoxItem Tag="loc:NotificationBoth" Content="Windows and overlay" />
                            </ComboBox>
                            <StackPanel x:Name="OverlayPreferencesPanel" Spacing="16" Visibility="Collapsed">
                                <StackPanel Spacing="8">
                                    <StackPanel x:Name="OverlayTransparencyField" Spacing="8" Width="{StaticResource SettingsControlWidth}" MaxWidth="{Binding ActualWidth, ElementName=SettingsContent}" HorizontalAlignment="Left">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <TextBlock Tag="loc:OverlayTransparency" TextWrapping="Wrap" />
                                            <TextBlock x:Name="OverlayTransparencyValue" Grid.Column="1" Text="20%" />
                                        </Grid>
                                        <Slider x:Name="OverlayTransparencySlider" Tag="loc:OverlayTransparency" Minimum="0" Maximum="100" StepFrequency="5" Value="20" ValueChanged="OverlayTransparencyChanged" />
                                    </StackPanel>
                                </StackPanel>
                                <ComboBox x:Name="OverlayPositionChoice" Tag="loc:OverlayPosition" Header="Position" SelectedIndex="0" Style="{StaticResource SettingsChoiceStyle}" MaxWidth="{Binding ActualWidth, ElementName=SettingsContent}" SelectionChanged="GeneralChanged">
                                    <ComboBoxItem Tag="loc:OverlayTopRight" /><ComboBoxItem Tag="loc:OverlayBottomRight" />
                                    <ComboBoxItem Tag="loc:OverlayTopLeft" /><ComboBoxItem Tag="loc:OverlayBottomLeft" />
                                </ComboBox>
                                <ComboBox x:Name="OverlayDurationChoice" Tag="loc:OverlayDuration" Header="Duration" SelectedIndex="1" Style="{StaticResource SettingsChoiceStyle}" MaxWidth="{Binding ActualWidth, ElementName=SettingsContent}" SelectionChanged="GeneralChanged">
                                    <ComboBoxItem /><ComboBoxItem /><ComboBoxItem /><ComboBoxItem /><ComboBoxItem />
                                </ComboBox>
                                <ComboBox x:Name="OverlayMonitorChoice" Tag="loc:OverlayMonitor" Header="Display" SelectedIndex="0" Style="{StaticResource SettingsChoiceStyle}" MaxWidth="{Binding ActualWidth, ElementName=SettingsContent}" SelectionChanged="GeneralChanged">
                                    <ComboBoxItem Tag="loc:OverlayMonitorActive" /><ComboBoxItem Tag="loc:OverlayMonitorPrimary" />
                                </ComboBox>
                                <ToggleSwitch x:Name="NotificationAfterFullscreenSwitch" Tag="loc:NotificationAfterFullscreen" Header="Remind again after fullscreen" IsOn="True" Toggled="PreferenceToggled" />
                                <TextBlock x:Name="NotificationAfterFullscreenHint" Tag="loc:NotificationAfterFullscreenHint" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <ToggleSwitch x:Name="NotificationSoundSwitch" Tag="loc:NotificationSound" Header="Play notification sound" IsOn="True" Toggled="PreferenceToggled" />
                            <Button x:Name="TestNoticeButton" Tag="loc:TestNotification" Content="Test notification" Click="TestNotificationClick" />
                        </StackPanel>
                        <StackPanel x:Name="AboutPanel" Spacing="16" Visibility="Collapsed">
                            <StackPanel Spacing="6">
                                <TextBlock Tag="loc:AppName" Text="PowerDock" Style="{ThemeResource TitleTextBlockStyle}" />
                                <TextBlock x:Name="VersionText" TextWrapping="Wrap" />
                                <TextBlock Tag="loc:AppDescription" Text="Lightweight native peripheral battery monitoring." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <Border x:Name="UpdateCard" Visibility="Collapsed" Padding="16" CornerRadius="{ThemeResource OverlayCornerRadius}" BorderThickness="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                                <StackPanel Spacing="12">
                                    <TextBlock Tag="loc:Updates" Text="App updates" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                    <TextBlock x:Name="UpdateStatusText" Visibility="Collapsed" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                                    <ProgressBar x:Name="UpdateProgress" Minimum="0" Maximum="100" Visibility="Collapsed" AutomationProperties.Name="Update progress" />
                                    <StackPanel Spacing="8" HorizontalAlignment="Left">
                                        <Button x:Name="CheckUpdateButton" Tag="loc:CheckUpdates" Content="Check for updates" Visibility="Collapsed" Click="CheckUpdatesClick" />
                                        <Button x:Name="DownloadUpdateButton" Tag="loc:DownloadUpdate" Content="Download update" Click="DownloadUpdatesClick" Visibility="Collapsed" />
                                        <Button x:Name="RestartUpdateButton" Tag="loc:RestartUpdate" Content="Restart and update" Click="ApplyUpdatesClick" Visibility="Collapsed" />
                                    </StackPanel>
                                    <HyperlinkButton x:Name="UpdateBuildLink" Tag="loc:GetUpdateBuild" Content="Get the self-updating edition" NavigateUri="https://github.com/jiazengp/powerdock/releases" Visibility="Collapsed" Padding="0" />
                                    <Expander x:Name="NotesExpander" Tag="loc:UpdateNotes" Header="Release notes" Visibility="Collapsed" HorizontalAlignment="Stretch">
                                        <TextBlock x:Name="ReleaseNotesText" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                    </Expander>
                                    <Expander x:Name="DetailsExpander" Tag="loc:UpdateDetails" Header="Technical details" Visibility="Collapsed" HorizontalAlignment="Stretch">
                                        <TextBlock x:Name="UpdateDetailsText" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                    </Expander>
                                </StackPanel>
                            </Border>
                            <ToggleSwitch x:Name="AutoCheckSwitch" Tag="loc:AutoCheck" Header="Check for updates automatically" IsOn="True" Toggled="PreferenceToggled" />
                            <ToggleSwitch x:Name="AutoDownloadSwitch" Tag="loc:AutoDownload" Header="Download automatically and install on exit" IsOn="True" Toggled="PreferenceToggled" />
                            <ToggleSwitch x:Name="PreviewSwitch" Tag="loc:PreviewUpdates" Header="Receive preview updates" Toggled="PreferenceToggled" />
                            <StackPanel Spacing="8" HorizontalAlignment="Left">
                                <HyperlinkButton Tag="loc:Source" Content="Source code" NavigateUri="https://github.com/jiazengp/powerdock" Padding="0" />
                                <HyperlinkButton Tag="loc:Releases" Content="Releases" NavigateUri="https://github.com/jiazengp/powerdock/releases" Padding="0" />
                                <HyperlinkButton Tag="loc:Feedback" Content="Report an issue" NavigateUri="https://github.com/jiazengp/powerdock/issues" Padding="0" />
                            </StackPanel>
                            <Button Tag="loc:Licenses" Content="License and third-party notices" Click="LicensesClick" />
                            <Expander x:Name="DiagnosticsExpander" Tag="loc:Diagnostics" Header="Diagnostics" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="0,12,0,0">
                                <StackPanel Spacing="12" Margin="12,0,0,0">
                                    <TextBlock Tag="loc:DiagnosticsDescription" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock x:Name="DiagnosticsStatusText" Visibility="Collapsed" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" AutomationProperties.LiveSetting="Polite" />
                                    <Border x:Name="RecentLogCard" Visibility="Collapsed" HorizontalAlignment="Stretch">
                                        <StackPanel Spacing="6">
                                            <TextBlock Tag="loc:RecentLogs" Text="Recent logs" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock x:Name="RecentLogText" FontFamily="Cascadia Mono, Consolas" FontSize="11" IsTextSelectionEnabled="True" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                                        </StackPanel>
                                    </Border>
                                    <Grid ColumnSpacing="8" Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Button x:Name="CopyLogsButton" Tag="loc:CopyLogs" Content="Copy logs" Click="CopyDiagnosticsClick" />
                                            <Button Tag="loc:OpenLogs" Content="Open folder" Click="OpenLogsClick" />
                                            <Button Tag="loc:ExportDiagnostics" Content="Export diagnostics" Click="ExportDiagnosticsClick" />
                                        </StackPanel>
                                        <TextBlock x:Name="DiagnosticsFeedbackText" Grid.Column="1" Visibility="Collapsed" FontWeight="SemiBold" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite" />
                                    </Grid>
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </NavigationView>
        </Grid>
        <TitleBar x:Name="AppTitleBar" IsBackButtonVisible="False" Padding="8,0,0,0" Height="48">
            <TitleBar.LeftHeader>
                <Button x:Name="BackButton" Visibility="Collapsed" Margin="16,0,0,0" Style="{StaticResource HeaderIconButtonStyle}" VerticalAlignment="Center" Click="BackClick">
                    <FontIcon Glyph="&#xE72B;" FontSize="14" Width="20" Height="20" IsTextScaleFactorEnabled="False" />
                </Button>
            </TitleBar.LeftHeader>
        </TitleBar>
    </Grid>
</Window>
